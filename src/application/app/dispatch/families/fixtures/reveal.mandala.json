{
  "format": 1,
  "name": "Reveal",
  "presentations": [
    {
      "id": "concealed",
      "name": "Concealed",
      "description": "Hides a node until it is stopped; the node then fades in.",
      "play": "hold",
      "target": "node",
      "mutations": [
        {
          "node": {
            "set_hidden": true
          }
        },
        {
          "node": {
            "set_opacity": 0.0
          }
        }
      ],
      "return": {
        "ms": 400,
        "easing": "ease_out"
      }
    }
  ],
  "verbs": [
    {
      "id": "begin",
      "name": "Begin",
      "description": "Conceals every channel-1 node: the days, until each is revealed.",
      "steps": [
        {
          "present": "concealed",
          "on": {
            "channel": 1,
            "within": "map"
          }
        }
      ]
    },
    {
      "id": "next-1",
      "name": "The first day",
      "steps": [
        {
          "stop": "concealed",
          "on": {
            "nodes": [
              2
            ]
          }
        }
      ]
    },
    {
