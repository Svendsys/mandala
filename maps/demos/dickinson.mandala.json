{
  "format": 1,
  "name": "Hope is the thing with feathers",
  "presentations": [
    {
      "id": "hope-swells",
      "name": "Hope swells",
      "description": "The word \"Hope\" grows and settles, over and over. Start it on node 1.",
      "play": "loop",
      "layer": "glyph",
      "target": "sections",
      "filter": {
        "fields": [
          [
            {
              "channel": 0
            },
            {
              "Equals": false
            }
          ]
        ]
      },
      "glyph": [
        {
          "run_overrides": {
            "scale": {
              "range": [
                1,
                5
              ],
              "value": 1.12
            }
          }
        }
      ],
      "animate": {
        "ms": 1600,
        "easing": "ease_in_out"
      },
      "return": {
        "ms": 1600,
        "easing": "ease_in_out"
      }
    },
    {
      "id": "feathers-line",
      "name": "Feathers' line, held",
      "description": "Holds the first line where centering puts it at rest, aligned left at that offset, so the trail \"feathers-trail\" writes after it moves nothing before it. Start it on node 1 before \"feathers-trail\".",
      "play": "hold",
      "layer": "document",
      "target": "sections",
      "filter": {
        "fields": [
          [
            {
              "channel": 0
            },
            {
              "Equals": false
            }
          ]
        ]
      },
      "mutations": [
        {
          "section": {
            "set_align": "left"
          }
        },
        {
          "section": {
            "set_offset": [
              130.87206,
              0.0
            ]
          }
        },
        {
          "section": {
            "set_min_size": [
              0.0,
              0.0
            ]
          }
        }
      ]
    },
    {
      "id": "feathers-trail",
      "name": "Feathers' trail",
      "description": "Writes the trail of dots after \"feathers\" into the line's last span, which the map saves empty: five glyphs of the same run, unseen until \"feathers-rest\" and \"feathers-lift\" color and lift them, and never saved, exported or found while nothing plays. Start it on node 1, after \"feathers-line\" and before those two.",
      "play": "hold",
      "layer": "document",
      "target": "spans",
      "filter": {
        "fields": [
          [
            {
              "font_size": {
                "pt": 40.0
              }
            },
            {
              "Equals": false
            }
          ]
        ]
      },
      "mutations": [
        {
          "span": {
            "set_text": " ·····"
          }
        }
      ]
    },
    {
      "id": "feathers-rest",
      "name": "Feathers at rest",
      "description": "Gives the letters of \"feathers\" and the trail after them the colors they rest in, so that \"feathers-lift\", started after it, fades them from there: a color blends only from a color a presentation gave.",
      "play": "hold",
      "layer": "glyph",
      "target": "sections",
      "filter": {
