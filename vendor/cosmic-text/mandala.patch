+/// a run's fallback asks the same shaping of each face.
+fn drawn_by_no_face(
+    font_system: &mut FontSystem,
+    ch: char,
+    rtl: bool,
+    weight: fontdb::Weight,
+    work: &mut ShapeWork,
+) -> bool {
+    let key = (ch, rtl, weight.0);
